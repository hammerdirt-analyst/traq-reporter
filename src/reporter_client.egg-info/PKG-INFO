      "image_path": "../assets/images/project_alpha/context_2.jpg",
      "caption": "Project Alpha pedestrian interface"
    }
  ],
  "tree_table": [
    {
      "tree_id": "job_123",
      "job_number": "TRAQ-123",
      "tree_name": "Tree 12",
      "tree_path": "../trees/traq-123.md",
      "species_common": "Coast Live Oak",
      "species_latin": "Quercus agrifolia",
      "dbh": "34 in",
      "height": "42 ft",
      "risk_rating": "Moderate",
      "main_concerns": "Codominant stems; included bark; deadwood over walkway"
    }
  ],
  "trees": [
    {
      "tree_id": "job_123",
      "job_number": "TRAQ-123",
      "tree_name": "Tree 12",
      "tree_path": "../trees/traq-123.md",
      "hero_image_path": "../assets/images/job_123/hero.jpg",
      "excerpt": "FUNCTION: generate_tree_excerpt(tree_record)"
    }
  ]
}
```

## Tree Schema

```json
{
  "page_type": "tree",
  "tree_id": "job_123",
  "job_id": "job_123",
  "job_number": "TRAQ-123",
  "tree_name": "Tree 12",
  "layout": {
    "header": {
      "site_title": "Urban Forestry Assessment Report",
      "project_tagline": "Static reporting site for completed field assessments",
      "logo_path": "../assets/branding/logo.png"
    },
    "navbar": [
      { "label": "Home", "path": "../index.md" },
      { "label": "Projects", "path": "../projects/index.md" },
      { "label": "Maps", "path": "../maps/index.md" }
    ],
    "footer": {
      "organization_name": "An Arborist",
      "published_text": "Published from local reporting artifacts",
      "updated_at": "2026-03-25T00:00:00Z"
    }
  },
  "project_id": "project_alpha",
  "project_name": "Project Alpha",
  "project_path": "../projects/project_alpha.md",
  "species_common": "Coast Live Oak",
  "species_latin": "Quercus agrifolia",
  "dbh": "34 in",
  "height": "42 ft",
  "risk_rating": "Moderate",
  "main_concerns": [
    "Codominant stems with included bark",
    "Deadwood extending over pedestrian path",
    "Asymmetric crown loading toward target area"
  ],
  "location": {
    "label": "North path near parking edge",
    "latitude": 37.0001,
    "longitude": -122.0001
  },
  "tree_map": {
    "image_path": "../assets/maps/job_123_locator.svg",
    "alt": "Locator map for Tree 12"
  },
  "artifacts": {
    "geojson_path": "../assets/geojson/job_123.geojson",
    "source_image_dir": "../assets/images/job_123/"
  },
  "images": [
    {
      "image_id": "img_1",
      "image_path": "../assets/images/job_123/img_1.jpg",
      "thumb_path": "../assets/images/job_123/thumb_img_1.jpg",
      "caption": "Root flare and lower stem from south side"
    },
    {
      "image_id": "img_2",
      "image_path": "../assets/images/job_123/img_2.jpg",
      "thumb_path": "../assets/images/job_123/thumb_img_2.jpg",
      "caption": "Crown structure over adjacent walkway"
    }
  ],
  "generated": {
    "title_text": "FUNCTION: generate_tree_title(tree_record)",
    "summary_text": "FUNCTION: generate_tree_summary(tree_record)",
    "narrative_paragraphs": [
      "FUNCTION: generate_tree_narrative(tree_record):paragraph_1",
      "FUNCTION: generate_tree_narrative(tree_record):paragraph_2",
      "FUNCTION: generate_tree_narrative(tree_record):paragraph_3",
      "FUNCTION: generate_tree_narrative(tree_record):paragraph_4"
    ]
  },
  "provenance": {
    "prompt_version": "v0-placeholder",
    "model": "placeholder",
    "generated_at": "2026-03-25T00:00:00Z"
  }
}
```

## Notes On Generated Fields

The `generated` block is where `F(a)` lands.

Examples:

- `generate_home_intro(site_summary)`
- `generate_project_summary(project_record)`
- `generate_tree_excerpt(tree_record)`
- `generate_tree_narrative(tree_record)`

This allows page templates to be finished before the live generation pipeline exists.

## Minimum Renderer Expectations

The docs generator should assume:

- every page has a title and summary block
- every page has header, navbar, and footer data
- every project page has a map and table
- project and tree pages reserve image gallery space
- every tree page has images and 3-4 paragraphs
- missing optional assets should degrade gracefully

## v1 Publication Rule

For v1, page generation should use:

- `completed` export records as authoritative publish inputs
- cached local assets for images and GeoJSON
- placeholder generated text until the generation stage is wired
