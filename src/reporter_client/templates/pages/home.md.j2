---
updated_at: "{{ view.updated_at[:16].replace('T', ' ') if view.updated_at else '' }}"
---

{% import "components/report_frame.j2" as frame %}

{% set description_html -%}
<div class="text-block" markdown="1">
{{ view.description_markdown }}
</div>
{%- endset %}

{% set summary_html -%}
<div class="text-block" markdown="1">
<hr class="section-rule" />
{{ view.summary_markdown }}
<hr class="section-rule" />
</div>
{%- endset %}

{% set summary_table_html -%}
<div class="summary-grid">
  <section class="panel">
    {% with summary=view.summary_metrics %}
    {% include "components/home_summary_table.j2" %}
    {% endwith %}
  </section>
  <section class="panel">
    <ul>
      {% for item in view.project_links %}
      <li><a href="{{ item.href }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </section>
</div>
{%- endset %}

{{ frame.render(view.page_title, view.breadcrumbs, description_html=description_html, summary_html=summary_html, summary_table_html=summary_table_html) }}
